<Window x:Class="CyberThreatAnalyzer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cyber Threat Analyzer" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <TabControl Padding="10">
         
            <TabItem Header="Analyse URL / Domaine">
                <Grid DataContext="{Binding UrlVM}" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="URL à analyser :" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox Width="500" Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5" Margin="0,0,15,0"/>
                        <Button Content="Lancer l'analyse" Command="{Binding AnalyzeCommand}" Width="150" Padding="5" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <ProgressBar IsIndeterminate="True" Height="10" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>

                    <ContentControl Grid.Row="2" Content="{Binding Result}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#FDFDFD" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Url}" FontWeight="Bold" FontSize="22" Foreground="#2C3E50" Margin="0,0,0,15"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <TextBlock Text="Niveau de menace : " FontSize="16" VerticalAlignment="Center"/>
                                                <Ellipse Fill="{Binding ThreatLevelColor}" Width="20" Height="20" Margin="10,0" Stroke="Black" StrokeThickness="1"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastAnalysisDate, StringFormat='Dernière analyse effectuée le : {0:dd/MM/yyyy à HH:mm}'}" FontSize="14" Foreground="Gray" Margin="0,5,0,15"/>
                                            <Border Background="#E8F6F3" Padding="10" CornerRadius="5" Margin="0,0,0,20">
                                                <TextBlock FontSize="16">
                                                    <Run Text="Détections malveillantes : " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding MaliciousCount}" FontWeight="Bold" Foreground="DarkRed"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding TotalEngines}"/>
                                                    <Run Text=" moteurs antivirus."/>
                                                </TextBlock>
                                            </Border>
                                            <Separator Margin="0,10"/>
                                            <TextBlock Text="Détail des détections :" FontWeight="Bold" FontSize="18" Margin="0,10"/>
                                            
                                            <TextBlock Text="✔ Félicitations, aucun moteur n'a détecté de menace sur cette URL." Foreground="Green" FontWeight="Bold" Margin="10,5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MaliciousCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ItemsControl ItemsSource="{Binding MaliciousEngines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="200"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding EngineName}" FontWeight="Bold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ThreatType}" Foreground="DarkRed"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </TabItem>

            <TabItem Header="Analyse de Hash">
                <Grid DataContext="{Binding FileVM}" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Hash ou Fichier :" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox Width="350" Text="{Binding InputHash, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5" Margin="0,0,10,0"/>
                        <Button Content="Parcourir un fichier" Command="{Binding BrowseCommand}" Width="130" Padding="5" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Analyser" Command="{Binding AnalyzeHashCommand}" Width="100" Padding="5" Cursor="Hand"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1">
                        <ProgressBar IsIndeterminate="True" Height="10" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <ContentControl Grid.Row="2" Content="{Binding Result}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#FDFDFD" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="20" Foreground="#2C3E50" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Hash}" FontSize="14" Foreground="Gray" Margin="0,0,0,15"/>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <TextBlock Text="Niveau de menace : " FontSize="16" VerticalAlignment="Center"/>
                                                <Ellipse Fill="{Binding RiskColor}" Width="20" Height="20" Margin="10,0" Stroke="Black" StrokeThickness="1"/>
                                            </StackPanel>
                                            
                                            <TextBlock Text="{Binding Size, StringFormat='Taille : {0} octets'}" FontSize="14" Margin="0,5"/>
                                            <TextBlock Text="{Binding FileType, StringFormat='Type : {0}'}" FontSize="14" Margin="0,5,0,15"/>
                                            
                                            <Border Background="#E8F6F3" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                                                <TextBlock FontSize="16">
                                                    <Run Text="Détections : " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Positives}" FontWeight="Bold" Foreground="DarkRed"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding TotalEngines}"/>
                                                </TextBlock>
                                            </Border>
                                            
                                            <ItemsControl ItemsSource="{Binding EnginesAndThreats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="200"/> <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="Bold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="DarkRed"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </TabItem>

            <TabItem Header="Analyse IP">
                <Grid DataContext="{Binding IpVM}" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Adresse IP (IPv4) :" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox Width="300" Text="{Binding InputIp, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5" Margin="0,0,15,0"/>
                        <Button Content="Analyser l'IP" Command="{Binding AnalyzeCommand}" Width="150" Padding="5" Cursor="Hand"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1">
                        <ProgressBar IsIndeterminate="True" Height="10" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <ContentControl Grid.Row="2" Content="{Binding Result}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border Background="#FDFDFD" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Ip}" FontWeight="Bold" FontSize="22" Foreground="#2C3E50" Margin="0,0,0,15"/>
                                        <TextBlock Text="{Binding Country, StringFormat='Pays : {0}'}" FontSize="16" Margin="0,5"/>
                                        <TextBlock Text="{Binding Asn, StringFormat='Propriétaire (ASN) : {0}'}" FontSize="16" Margin="0,5"/>
                                        <TextBlock Text="{Binding ReputationScore, StringFormat='Score de réputation : {0}'}" FontSize="16" FontWeight="Bold" Foreground="DarkOrange" Margin="0,5"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </TabItem>

            <TabItem Header="Paramètres">
                <Grid DataContext="{Binding SettingsVM}" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/> <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Paramètres de l'application" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Algorithme Hash par défaut :" Margin="0,10,0,5" FontWeight="SemiBold"/>
                        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding CurrentSettings.DefaultHashAlgorithm}" Padding="5">
                            <ComboBoxItem Content="SHA-256"/>
                            <ComboBoxItem Content="SHA-1"/>
                            <ComboBoxItem Content="MD5"/>
                        </ComboBox>
                        
                        <TextBlock Text="Nombre maximum de résultats d'historique :" Margin="0,15,0,5" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CurrentSettings.MaxResults}" Padding="5"/>
                        
                        <CheckBox Content="Enregistrer l'historique des recherches" IsChecked="{Binding CurrentSettings.HistoryEnabled}" Margin="0,15,0,25" FontWeight="SemiBold"/>
                        
                        <Button Content="Sauvegarder les paramètres" Command="{Binding SaveCommand}" Padding="8" Cursor="Hand" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                    
                    <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Historique des recherches :" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding HistoryList}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White" RowHeight="30" VerticalScrollBarVisibility="Auto" Height="450">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                                    <DataGridTextColumn Header="Cible" Binding="{Binding Target}" Width="*"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>